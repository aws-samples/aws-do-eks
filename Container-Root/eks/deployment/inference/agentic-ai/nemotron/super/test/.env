#!/bin/bash

export DOLLAR='$'
# DEPLOYMENT_TYPE=agg|disagg
export DEPLOYMENT_TYPE="${DEPLOYMENT_TYPE:-agg}"
export DEPLOYMENT_NAME=nemotron35-super-vl-120b-${DEPLOYMENT_TYPE}

# MANIFEST_TYPE mirrors ../${DEPLOYMENT_TYPE}/.env and is used here for one purpose only:
# scoping the aiperf artifact directory. Nothing in test/ renders a manifest, so a value that
# does not match the deployed topology only mislabels the results folder.
# agg: deployment|dgd|dgd-v1beta1
# disagg: deployment|epd|dgd|dgd-v1beta1
export MANIFEST_TYPE="${MANIFEST_TYPE:-deployment}"
export SERVICE_NAME=${DEPLOYMENT_NAME}-frontend
# ${NAMESPACE:-default}, matching ../agg/.env and ../disagg/.env: an unconditional export
# here silently clobbers a caller's namespace override, so a stack deployed with
# NAMESPACE=<ns> gets benchmarked by a do-aiperf pod created in `default` — where fsx-pvc
# does not exist, so the pod sits Pending and every artifact collection fails.
export NAMESPACE=${NAMESPACE:-default}
export SERVICE_URL="http://${SERVICE_NAME}.${NAMESPACE}.svc.cluster.local:8000"

# Same precision derivation as ../agg/.env and ../disagg/.env — MODEL_NAME is the served
# label the frontend registers, MODEL_PATH is where the tokenizer/artifacts live.
# MODEL_PATH defaults to where ../download lands the Hugging Face checkpoint (ultra's layout).
# Weights obtained by any other route (for example Early-Access checkpoints already on an FSx
# volume) are served by exporting MODEL_PATH=<their directory> before ./run.sh; export the
# same value here so the tokenizer and the artifact directory resolve.
export MODEL_VARIANT="${MODEL_VARIANT:-BF16}"
export MODEL_REPO="${MODEL_REPO:-nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B}"
case "${MODEL_VARIANT}" in
  nvfp4|NVFP4|fp4) _PREC_SUFFIX="NVFP4" ;;
  bf16|BF16|*)     _PREC_SUFFIX="BF16"  ;;
esac
export MODEL_NAME="${MODEL_NAME:-${MODEL_REPO}-${_PREC_SUFFIX}}"
export MODEL_PATH="${MODEL_PATH:-/shared/models/hf/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${_PREC_SUFFIX}}"

# AIPERF_WORKLOAD selects what test-aiperf.sh benchmarks. llm (default) = the text workload
# identical to ../../ultra/test, comparable 1:1 with ultra's RESULTS.md; vl = synthetic images added.
export AIPERF_WORKLOAD="${AIPERF_WORKLOAD:-llm}"
# Synthetic image size; applies only when AIPERF_WORKLOAD=vl. 512 matches the checkpoint's
# force_image_size.
export AIPERF_IMAGE_WIDTH="${AIPERF_IMAGE_WIDTH:-512}"
export AIPERF_IMAGE_HEIGHT="${AIPERF_IMAGE_HEIGHT:-512}"
