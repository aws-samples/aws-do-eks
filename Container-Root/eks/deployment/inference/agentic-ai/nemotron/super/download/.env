#!/bin/bash

export MODEL_PRECISION=${MODEL_PRECISION:-BF16}
#export MODEL_PRECISION=NVFP4

# ---- NGC model identifier (REQUIRED — no default on purpose) ----
# The Early-Access weights are distributed through the NGC model registry, not (yet) through
# a public Hugging Face repo. Set NGC_MODEL to the EA model string from your NGC entitlement,
# exactly as the model card's "Download" tab shows it:
#   NGC_MODEL="<org>/<team>/<model>:<version>"
# This file deliberately ships EMPTY — the EA org/team path is entitlement-specific and
# guessing one here would fail everyone's download. model-download.sh refuses to run until
# it is set.
export NGC_MODEL=${NGC_MODEL:-}

# Where the checkpoint lands on the shared FSx volume (mounted at /shared in the do-ngc pod
# and in every serving pod). `ngc registry model download-version` creates
# ${DOWNLOAD_ROOT}/<model-name>_v<version>/ under this directory — the serving .env files
# default MODEL_PATH to exactly that layout:
#   /shared/nemotron/super/bf16/nemotron_3_5_super_ga_candidate_mtp_boosted_20261001_vv0.1
#   /shared/nemotron/super/nvfp4/nemotron_3_5_super_ga_candidate_mtp_boosted_nvfp4_20261001_vv0.1
case "${MODEL_PRECISION}" in
  nvfp4|NVFP4|fp4) _PREC_DIR="nvfp4" ;;
  *)               _PREC_DIR="bf16"  ;;
esac
export DOWNLOAD_ROOT=${DOWNLOAD_ROOT:-/shared/nemotron/super/${_PREC_DIR}}

# ---- NGC API key: a Kubernetes Secret, NEVER a value in this file ----
# model-download.sh injects the key into the do-ngc pod from a Secret named ngc-api-key:
#   kubectl create secret generic ngc-api-key --from-literal=NGC_API_KEY=<your key>
export NGC_SECRET_NAME=${NGC_SECRET_NAME:-ngc-api-key}

# ---- Post-GA alternative: Hugging Face ----
# Once the model is published on HF, the ../../ultra/download pattern applies verbatim
# (iankoulski/do-hf pod + `hf download`). Example, kept for that day:
#   export MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${MODEL_PRECISION}
#   export MODEL_PATH=/shared/models/hf/${MODEL_NAME}
#   export HF_TOKEN=
