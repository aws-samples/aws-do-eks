#!/bin/bash

export MODEL_PRECISION=BF16
#export MODEL_PRECISION=NVFP4

# The repo id follows the Early-Access model-card names (NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-{BF16,NVFP4})
# and ../../ultra/download's naming. Confirm it against the public Hugging Face model card at GA:
# MODEL_NAME below is the one line to correct if the published repo id differs.
export MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${MODEL_PRECISION}
export MODEL_PATH=/shared/models/hf/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${MODEL_PRECISION}
export HF_TOKEN=

