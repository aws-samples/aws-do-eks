+def _as_py_list(value: Any) -> list:
+    """BatchFeature(tensor_type="pt") turns list fields into tensors; accept both forms."""
+    if isinstance(value, torch.Tensor):
+        return value.tolist()
+    return list(value)
+
+
+def get_nemotron_h_omni_image_features(
+    model: torch.nn.Module, image_embeds: Dict[str, Any]
+) -> list[torch.Tensor]:
+    """
+    Vision features for the NemotronH Omni / Nano-VL family (dynamic-resolution tiler).
+
+    `model` is vLLM's `NemotronH_Nano_VL_V2` composite loaded in --mm-encoder-only mode
+    (RADIO `vision_model` + pixel shuffle + `mlp1`). The HF image processor emits ONE tile
+    per image: `pixel_values` is a stacked (n, 3, H, W) tensor when every tile has the same
+    size, otherwise a list of (3, H_i, W_i) tensors, plus `imgs_sizes` = per-image (H, W).
+    This mirrors the model's own pixel path (`_parse_and_validate_image_input` ->
+    `DynamicResolutionImageTiler.stack` -> `extract_feature_dynamic`) and returns one
+    (num_tokens_i, hidden) tensor per image, in input order.
+    """
+    from vllm.transformers_utils.processors.nano_nemotron_vl import (
+        DynamicResolutionImageTiler,
+    )
+
+    pixel_values = image_embeds["pixel_values"]
+    tiles = (
+        [t for t in pixel_values]
+        if isinstance(pixel_values, torch.Tensor)
+        else list(pixel_values)
+    )
+    if not tiles:
+        raise ValueError("no image tiles to encode")
+    if image_embeds.get("imgs_sizes") is not None:
+        imgs_sizes = [(int(h), int(w)) for h, w in _as_py_list(image_embeds["imgs_sizes"])]
+    else:
+        imgs_sizes = [(int(t.shape[-2]), int(t.shape[-1])) for t in tiles]
+    if len(imgs_sizes) != len(tiles):
+        raise ValueError(
+            f"imgs_sizes ({len(imgs_sizes)}) does not match the tile count ({len(tiles)})"
+        )
+    patch_size = int(model.patch_size)
+    reduction = int(round(1 / float(model.downsample_ratio))) ** 2
+    num_tokens = [(h // patch_size) * (w // patch_size) // reduction for h, w in imgs_sizes]
+    device = next(model.mlp1.parameters()).device
+    stacked = DynamicResolutionImageTiler.stack(
+        [t.to(torch.float32) for t in tiles], patch_size
+    ).to(device=device, dtype=model.llm_dtype)
+    features = model.extract_feature_dynamic(stacked, imgs_sizes)
+    hidden = features.shape[-1]
+    features = features.reshape(-1, hidden)
+    if features.shape[0] != sum(num_tokens):
+        raise RuntimeError(
+            f"encoder returned {features.shape[0]} visual tokens, expected {sum(num_tokens)} "
+            f"for imgs_sizes={imgs_sizes}"
+        )
+    return list(features.split(num_tokens))
+
