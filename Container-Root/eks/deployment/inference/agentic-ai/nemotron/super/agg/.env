#!/bin/bash

# Default image = the STOCK NGC runtime. Unlike ../../ultra (whose manifests default to a
# published golden image), no dynamo-vllm-efa golden image for Super has been built or pushed
# yet; defaulting to a tag that does not exist would make every pod ImagePullBackOff. The
# ../../dynamo-vllm-efa folder (shared with ../../ultra) carries the golden-image recipe (CVE remediation + base asserts);
# once it is built and pushed, point these three at it, e.g.:
#   REGISTRY=public.ecr.aws/hpc-cloud/ IMAGE=dynamo-vllm-efa TAG=":1.5.0-super-patched"
# 1.5.0-efa = Dynamo 1.5.0 / vLLM 0.28.0 / EFA 1.50.0 baked (verified by inspection
# 2026-10-06: ai-dynamo 1.5.0, vllm 0.28.0, /opt/amazon/efa 1.50.0, NIXL 1.3.2 with the
# LIBFABRIC plugin present).
export REGISTRY=${REGISTRY:-nvcr.io/nvidia/ai-dynamo/}
export IMAGE=${IMAGE:-vllm-runtime}
export TAG=${TAG:-":1.5.0-efa"}

export DOLLAR='$'
# ${VAR:-default} everywhere: an unconditional export here would silently clobber a
# caller's environment override (run.sh/stop.sh source this file) - for NAMESPACE that
# means stop.sh could render its deletes into somebody ELSE's namespace.
# NAMESPACE = the namespace that holds fsx-pvc (every template mounts it); the deployment lands there too.
# On the EKS Auto Mode p5e cluster that was `default` (NAMESPACE=default on the launch line); on a shared
# cluster use your own namespace with its own fsx-pvc.
export NAMESPACE=${NAMESPACE:-default}
export DEPLOYMENT_NAME=${DEPLOYMENT_NAME:-nemotron35-super-vl-120b-agg}

# MANIFEST_TYPE=deployment|lws|lws-ep|dgd|dgd-v1beta1|dgd-grove|dgd-grove-ep
#   deployment : plain Deployment, 1 worker node, TP8/PP1 (simplest)
#   lws        : LeaderWorkerSet, one engine TP8/PP2 across 2 nodes (Ray bootstrap, as in ../../ultra)
#   lws-ep     : EP16 aggregated - LWS DP2 x TP8 with --enable-expert-parallel (EP degree 16). Runs
#                native `vllm serve` (no dynamo frontend), so it carries no --enable-multimodal
#                (vLLM 0.28 has no such flag; it serves image_url content natively) - see its header
#   dgd        : DynamoGraphDeployment via the Dynamo operator (needs ../../../nvidia-dynamo)
#   dgd-v1beta1: the SAME deployment on the nvidia.com/v1beta1 API. On a Dynamo 1.5.0
#                platform v1beta1 is the CRD's STORAGE version (the v1.5.0 release notes),
#                so this is the native API there; dgd (v1alpha1) stays for older platforms.
#   dgd-grove  : MULTINODE aggregated - the lws engine shape (one engine, TP8 x PP
#                NODE_COUNT_PER_WORKER across that many nodes) expressed as a v1beta1 DGD
#                with multinode.nodeCount, rendered by the operator as a Grove PodCliqueSet
#                and gang-scheduled by kai-scheduler. Needs Dynamo >= 1.4.0 platform AND
#                ../../../grove (Grove + KAI) installed; see the template header.
#   dgd-grove-ep: the lws-ep topology (AGGREGATED wide-EP, one engine DP EP_DP_SIZE x TP8 with
#                --enable-expert-parallel, EP degree 16 by default) as a Grove-rendered v1beta1
#                DGD: the worker carries multinode.nodeCount=EP_DP_SIZE and the OPERATOR injects
#                vLLM's DP coordination (hybrid-lb - a DIFFERENT coordination mode than the
#                external-lb wiring lws-ep uses). Same prerequisites as dgd-grove.
# The multinode shapes (lws, lws-ep, dgd-grove, dgd-grove-ep) exist for MANIFEST_TYPE parity with
# ../../ultra, where they are needed to fit the 550B model. Super-VL 120B-A12B BF16 is a ~249 GB
# checkpoint, so a single 8-GPU node holds it with headroom and these shapes are OPTIONAL here,
# not required. Each is ultra's template with only the Super delta applied; all four were served and
# measured live on H200 on 2026-10-19 (see ../test/RESULTS.md). NONE of these disaggregate prefill from decode - that is
# ../disagg (every template there carries --kv-transfer-config). lws-ep in particular is
# AGGREGATED wide-EP, so report its numbers as AGGREGATED. ../disagg/.env offers the SAME NAME
# `lws-ep` for the DISAGGREGATED expert-parallel shape (EP16 per role + a real KV transfer,
# 2 * EP_DP_SIZE nodes): the folder decides the mode, MANIFEST_TYPE decides the topology within
# it. Do not compare across the two except at equal GPU count and on ITL / p50 TTFT.
export MANIFEST_TYPE=${MANIFEST_TYPE:-deployment}

# ---- Cluster shape ----
# All ${VAR:-default} so a different accelerator is a one-liner and needs no edit here:
#   INSTANCE_TYPE_WORKER=p6-b200.48xlarge EFA_PER_WORKER=<node allocatable> ./run.sh
# On SageMaker HyperPod EKS the node label carries an ml. prefix (e.g.
# ml.p6-b200.48xlarge) and B200 nodes advertise 8 EFA, not 16 - read the node, not this file.
# Instance type -> vpc.amazonaws.com/efa allocatable (EC2 MaximumEfaInterfaces; confirm with the one-liner below):
#   p5en.48xlarge 16 (the default below) | p5e.48xlarge 32 | p6-b200.48xlarge 8 | HyperPod EKS: same counts, ml. prefix
# EKS Auto Mode (Karpenter-managed nodes; MEASURED 2026-10-19/20 on 4x p5e.48xlarge, see ../test/RESULTS.md p5e notes).
# The launch line that ran every p5e cell, no template edits:
#   INSTANCE_TYPE_WORKER=p5e.48xlarge EFA_PER_WORKER=32 NAMESPACE=default INSTANCE_TYPE_FRONTEND=m7i.xlarge ./run.sh
# Karpenter reads the frontend's PREFERRED instance type as a provisioning hint, not a fallback: the general-purpose
# NodePool launched a NEW node of that type for the frontend (a type that exists but has no room gets a new node too)
# and consolidated it away after the deployment was deleted. Pick a type that exists in the cluster with room, or
# accept one extra small node per deployment. Traditional clusters (managed node groups / HyperPod) are unaffected:
# the preference falls back to an existing node. Auto Mode exposes nvidia.com/gpu and vpc.amazonaws.com/efa itself
# (no device-plugin install), its GPU nodes carry the nvidia.com/gpu:NoSchedule taint (every GPU container here
# tolerates it), and /dev/gdrdrv comes from eks/deployment/nvidia-drivers/gdrcopy-daemonset-bottlerocket.yaml.
# INSTANCE_TYPE_FRONTEND is a *preference*, not a requirement: the frontend prefers this
# instance type and falls back to any schedulable node (incl. a GPU node) when the cluster
# has none, so an all-GPU cluster does not leave the router Pending.
export INSTANCE_TYPE_FRONTEND=${INSTANCE_TYPE_FRONTEND:-m5.8xlarge}
export INSTANCE_TYPE_WORKER=${INSTANCE_TYPE_WORKER:-p5en.48xlarge}
export GPU_PER_WORKER=${GPU_PER_WORKER:-8}
# EFA_PER_WORKER must match what the EFA device plugin advertises on YOUR instance type - read
# it, do not assume it, or the GPU pods sit Pending on Insufficient vpc.amazonaws.com/efa:
#   kubectl get node <node> -o jsonpath='{.status.allocatable.vpc\.amazonaws\.com/efa}{"\n"}'
export EFA_PER_WORKER=${EFA_PER_WORKER:-16}

# dgd-grove only: nodes per multinode worker group. The engine spans
# NODE_COUNT_PER_WORKER full nodes as TP${GPU_PER_WORKER} x PP${NODE_COUNT_PER_WORKER}
# (PP grows with the node count; TP stays inside the node).
export NODE_COUNT_PER_WORKER=${NODE_COUNT_PER_WORKER:-2}

# lws-ep and dgd-grove-ep: data-parallel group size; EP degree = EP_DP_SIZE * GPU_PER_WORKER.
# dgd-grove-ep also uses it as the worker's multinode.nodeCount (one DP rank per node).
# The model's expert count must be divisible by the EP degree (Nemotron 3.5 Super VL has 512
# routed experts per its config.json: EP16 = 32 per rank, exact; Mixtral's 8 experts cannot
# run EP16).
export EP_DP_SIZE=${EP_DP_SIZE:-2}
# Per-GPU-pod CPU/memory budget, requests == limits (Guaranteed QoS). 48 is the portable
# default - it fits both p5en.48xlarge and p6-b200.48xlarge and leaves headroom for the
# EFA/GPU DaemonSets.
export CPU_PER_WORKER=${CPU_PER_WORKER:-48}
export MEM_PER_WORKER=${MEM_PER_WORKER:-800Gi}

# ---- Model precision toggle ----
# Switch between the full-precision BF16 checkpoint and the NVFP4 (4-bit) checkpoint
# WITHOUT editing the templates. BF16 is the default; set MODEL_VARIANT=NVFP4 to switch.
# vLLM auto-detects the quantization from the checkpoint (no --quantization flag needed).
# NOTE for H200 (sm90): there is no native FP4 compute - vLLM serves the NVFP4 checkpoint
# through its Marlin weight-only fallback (FP4-compressed weights, BF16 compute); B200
# (sm100) runs native-FP4 kernels. Same caveat as ../../ultra/test/RESULTS.md documents.
#
# MODEL_PATH defaults to where ../download lands the Hugging Face checkpoint on the shared FSx
# volume - the same /shared/models/hf/<repo id> layout as ../../ultra. Weights obtained by any
# other route (for example Early-Access checkpoints already on an FSx volume) are served by
# exporting MODEL_PATH=<their directory> before ./run.sh.
export MODEL_VARIANT="${MODEL_VARIANT:-BF16}"
export MODEL_REPO="${MODEL_REPO:-nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B}"
case "${MODEL_VARIANT}" in
  nvfp4|NVFP4|fp4) _PREC_SUFFIX="NVFP4" ;;
  bf16|BF16|*)     _PREC_SUFFIX="BF16"  ;;
esac
export MODEL_NAME="${MODEL_NAME:-${MODEL_REPO}-${_PREC_SUFFIX}}"
export MODEL_PATH="${MODEL_PATH:-/shared/models/hf/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${_PREC_SUFFIX}}"

# ---- Engine shape knobs (templates read these; ../../ultra hardcodes its equivalents) ----
# Ultra pins 4096/0.97 because 550B BF16 barely fits 8 GPUs; Super-VL BF16 is ~31 GB/GPU at
# TP8 on a 141 GB H200, so the context window is a real knob here. 32768 is a deliberately
# modest scaffold default - the checkpoint's max_position_embeddings is 1048576 - and no
# value has been benchmarked yet (see ../test/RESULTS.md).
export MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}
export GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}

# ---- Architecture-name override (REQUIRED on vLLM 0.28.x - read before changing) ----
# The checkpoint's config.json says architectures=["NemotronH_Omni_Reasoning_V3"]. vLLM
# 0.28.0 (the engine in vllm-runtime:1.5.0*) does not register that BARE name - it registers
# "NemotronH_Super_Omni_Reasoning_V3" and "NemotronH_Nano_Omni_Reasoning_V3", both mapping to
# the same implementation ("nano_nemotron_vl", "NemotronH_Nano_VL_V2"); the bare alias only
# appears in vLLM v0.29.0+ (registry.py line 515 at v0.29.0). The templates therefore pass
#   --hf-overrides '{"architectures":["${HF_OVERRIDE_ARCH}"]}'
# to load the checkpoint through the registered Super alias. Verified inside the 1.5.0-efa
# image (2026-10-06): Super alias registered = True, bare name = False.
# On a future base whose vLLM is >= 0.29.0 this override becomes a no-op you can keep, or
# set HF_OVERRIDE_ARCH=NemotronH_Omni_Reasoning_V3 to make it an identity override.
export HF_OVERRIDE_ARCH=${HF_OVERRIDE_ARCH:-NemotronH_Super_Omni_Reasoning_V3}

# Hybrid-Mamba flags are MODEL-CONDITIONAL, not universal (same guard as ../../ultra): on a
# pure-transformer model `--mamba-cache-mode align` fails at first inference. Auto-derived
# from MODEL_NAME; override MAMBA_FLAGS='' to force stock behavior. Both flags exist on
# vLLM 0.28.0 (arg_utils.py: mamba_cache_mode line 712, disable_hybrid_kv_cache_manager
# line 632). The llm_config's 128K-token-scale context support and mamba_ssm_cache_dtype
# float32 come from the checkpoint config itself - no flag needed.
case "${MODEL_NAME}" in
  *Nemotron*|*nemotron*) _MAMBA_DEFAULT="--mamba-cache-mode align --no-disable-hybrid-kv-cache-manager" ;;
  *)                     _MAMBA_DEFAULT="" ;;
esac
export MAMBA_FLAGS="${MAMBA_FLAGS-${_MAMBA_DEFAULT}}"

# ---- MTP speculative decoding toggle (OFF by default - no cell measured yet) ----
# The checkpoint ships one MTP draft layer (num_nextn_predict_layers=1,
# mtp_layers_block_type=["attention","moe"] - this is the "mtp_boosted" in the directory
# name). vLLM 0.28.0 supports it structurally: "nemotron_h_mtp" is in MTPModelTypes
# (speculative.py line 46 at v0.28.0) and model_executor/models/nemotron_h_mtp.py exists.
# "mtp" is the canonical method name at 0.28.0 - model-specific names like nemotron_h_mtp
# are accepted but deprecation-folded into "mtp" (speculative.py __post_init__); with no
# "model" key the draft weights load from the target checkpoint itself.
# UNVERIFIED end-to-end: whether the MTP draft path composes with the Omni/VL wrapper
# architecture has not been exercised on this checkpoint - that is why the default is 0.
# num_speculative_tokens=1 matches num_nextn_predict_layers=1.
export SPEC_DECODE=${SPEC_DECODE:-0}
case "${SPEC_DECODE}" in
  1|true|on) _SPEC_DEFAULT="--speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":1}'" ;;
  *)         _SPEC_DEFAULT="" ;;
esac
export SPEC_DECODE_FLAG="${SPEC_DECODE_FLAG-${_SPEC_DEFAULT}}"

# Weight loader. runai_streamer streams shards and overlaps download+load - what you want
# for a cold ~249 GB BF16 load over Lustre. Present in the 1.5.0-efa image (verified
# 2026-10-06: runai-model-streamer 0.16.1). Other values: auto (HF safetensors path,
# works everywhere), mx (modelexpress). Override per deployment: LOAD_FORMAT=auto ./run.sh
export LOAD_FORMAT="${LOAD_FORMAT:-runai_streamer}"

# NOTE: ../../ultra pins --moe-backend flashinfer_cutlass for BF16 - that pin encodes a
# MEASURED vLLM 0.26 regression on Nemotron-3-Ultra-550B (vllm#53472) and has not been
# measured on vLLM 0.28 or on this model, so it is deliberately NOT carried here. vLLM's
# auto selection stays in force; opt in explicitly by appending to MAMBA_FLAGS if you are
# reproducing that experiment.

# ---- Cold-start warmup (same mechanism and knobs as ../../ultra) ----
# A fresh pod's FIRST requests pay a one-time Triton JIT of the Mamba DECODE kernels
# (_selective_scan_update / _causal_conv1d_update): startup only warms the PREFILL SSD path,
# and --enforce-eager does not skip it (this is JIT, not cudagraph capture). Super-VL's
# llm_config is the same hybrid-Mamba NemotronH family (40 mamba layers), so the same
# mechanism applies; the ultra numbers (first request 7,782 ms -> 1,172 ms) are ultra's,
# not this model's - no Super cell is measured yet.
# These two MUST be exported here, not just set in your shell: the warmer evaluates them
# INSIDE the container, so they only take effect because the templates pass them through.
#   auto (default) = on for an *NVFP4* served-model name, off otherwise
export WARMUP_ENABLED=${WARMUP_ENABLED:-auto}
export WARMUP_CONCURRENCY=${WARMUP_CONCURRENCY:-10}

# ---- Test-only runtime bootstrap for the Ray / PP>1 shapes (default OFF) ----
# lws (TP8 x PP2 bootstrapped by Ray) and dgd-grove (TP8 x PP NODE_COUNT_PER_WORKER via the operator's mp bootstrap)
# need what the stock 1.5.0-efa image lacks: the `ray` package (Ray-bootstrapped shapes) and the
# SupportsPP patch for the NemotronH_Nano_VL_V2 wrapper (every PP>1 shape: vLLM 0.28.0 refuses PP>1 for
# it at verify_with_parallel_config). ../../dynamo-vllm-efa/Dockerfile bakes both into the golden image -
# that is the production path. RUNTIME_BOOTSTRAP=1 is the test-only fallback for a cluster that cannot
# pull a golden image yet: run.sh publishes ../../dynamo-vllm-efa/patches/ as a ConfigMap, the affected
# vllm containers run as root (the image's vllm tree is root-owned) and apply it at start
# (pip install ray[default]==2.55.1 + apply_pp_patch.py; +2-4 min per pod start). Default OFF renders
# the stock-image manifests: the bootstrap line is a no-op ':' and the ConfigMap volume is optional.
export RUNTIME_BOOTSTRAP=${RUNTIME_BOOTSTRAP:-0}
case "${RUNTIME_BOOTSTRAP}" in
  1|true|on)
    _RB_RAY='bash /opt/runtime-bootstrap/runtime-bootstrap.sh ray'
    _RB_PATCH='bash /opt/runtime-bootstrap/runtime-bootstrap.sh patch'
    _RB_SC=', runAsUser: 0' ;;
  *) _RB_RAY=':'; _RB_PATCH=':'; _RB_SC='' ;;
esac
export RUNTIME_BOOTSTRAP_RAY_CMD="${_RB_RAY}"
export RUNTIME_BOOTSTRAP_PATCH_CMD="${_RB_PATCH}"
export RUNTIME_BOOTSTRAP_SECURITY_CONTEXT="${_RB_SC}"

# ETCD and NATS endpoints
export ETCD_URL=http://dynamo-platform-etcd.dynamo-system.svc.cluster.local:2379
export NATS_URL=nats://dynamo-platform-nats.dynamo-system.svc.cluster.local:4222
