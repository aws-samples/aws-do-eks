#!/bin/bash

# Default image = the STOCK NGC runtime (same reasoning as ../agg/.env: no Super golden
# image has been built/pushed yet; ../dynamo-vllm-efa carries the recipe). Once built:
#   REGISTRY=public.ecr.aws/hpc-cloud/ IMAGE=dynamo-vllm-efa TAG=":1.5.0-super-patched"
# 1.5.0-efa = Dynamo 1.5.0 / vLLM 0.28.0 / EFA 1.50.0 / NIXL 1.3.2 with the LIBFABRIC
# plugin baked (verified by inspection 2026-10-06).
export REGISTRY=${REGISTRY:-nvcr.io/nvidia/ai-dynamo/}
export IMAGE=${IMAGE:-vllm-runtime}
export TAG=${TAG:-":1.5.0-efa"}

export DOLLAR='$'
# ${VAR:-default} everywhere: an unconditional export here would silently clobber a
# caller's environment override (run.sh/stop.sh source this file) - for NAMESPACE that
# means stop.sh could render its deletes into somebody ELSE's namespace.
export NAMESPACE=${NAMESPACE:-default}
export DEPLOYMENT_NAME=${DEPLOYMENT_NAME:-nemotron35-super-vl-120b-disagg}

# MANIFEST_TYPE=deployment|epd|lws-2pp|lws-pp2|lws-ep|dgd|dgd-v1beta1|dgd-grove|dgd-grove-pp2|dgd-grove-ep
#   deployment : plain Deployments, 1 prefill + 1 decode node, TP8/PP1 each (simplest).
#                KV moves prefill->decode over EFA RDMA via NIXL LIBFABRIC.
#   epd        : Encode + PD split for IMAGE traffic — a dedicated vision-encoder worker
#                plus ONE aggregated prefill+decode worker (dynamo v1.5.0's
#                launch/disagg_multimodal_e_pd.sh shape: encode gets
#                --disaggregation-mode encode, the PD worker gets --route-to-encoder
#                --disaggregation-mode pd --enable-mm-embeds). The disaggregation here is
#                encode-from-PD; there is NO prefill/decode KV split in this template.
#                READ THE TEMPLATE HEADER before relying on it — at dynamo v1.5.0 the
#                encode worker full-loads non-Qwen VL checkpoints, which constrains it.
#   lws-2pp    : LeaderWorkerSet, prefill TP8/PP2 (2 nodes) + decode 2x TP8/PP1 (2x PP1 decode pods)
#   lws-pp2    : LeaderWorkerSet, symmetrical PP2 - prefill AND decode each TP8/PP2 across 2 nodes
#   lws-ep     : LeaderWorkerSet, EP16 *disaggregated* - prefill DP2 x TP8 (EP16) + decode
#                DP2 x TP8 (EP16) across 4 nodes, --enable-expert-parallel on BOTH roles AND a
#                prefill/decode split
#   dgd        : DynamoGraphDeployment P/D via the Dynamo operator (../../../nvidia-dynamo)
#   dgd-v1beta1: the SAME P/D deployment on the nvidia.com/v1beta1 API. On a Dynamo 1.5.0
#                platform v1beta1 is the CRD's STORAGE version — the native API there.
#   dgd-grove  : the dgd-v1beta1 topology (1 prefill + 1 decode node, TP8/PP1 each) rendered
#                through Grove: on a Dynamo >= 1.4.0 operator with Grove + KAI installed
#                (../../../grove) the whole graph becomes one PodCliqueSet and is
#                GANG-scheduled - prefill can no longer boot alone and squat GPUs waiting
#                for a decode node. See the template header.
#   dgd-grove-pp2: the lws-pp2 topology (symmetric PP2 - prefill AND decode each
#                TP8/PP NODE_COUNT_PER_WORKER across that many nodes) as a Grove-rendered
#                v1beta1 DGD: both workers carry multinode.nodeCount and the operator injects
#                the rank bootstrap. PP>1 disagg caveat: on ultra this shape REQUIRED the
#                ':1.4.0-patched' golden image (stock vLLM 0.26 refused PP>1 + hybrid-KV in the
#                NIXL worker); whether the stock 1.5.0-efa runtime (vLLM 0.28) accepts it is
#                UNVERIFIED until a live run - read the template header.
#   dgd-grove-ep: the lws-ep topology (EP16 per role + P/D split, 2 * EP_DP_SIZE nodes) as a
#                Grove-rendered v1beta1 DGD: each role carries multinode.nodeCount=EP_DP_SIZE
#                and the OPERATOR injects vLLM's DP coordination (hybrid-lb - a DIFFERENT
#                coordination mode than the external-lb wiring lws-ep uses).
#
# The multinode shapes (lws-2pp, lws-pp2, lws-ep, dgd-grove-pp2, dgd-grove-ep) and the Grove
# render of the PP1 pair (dgd-grove) exist for MANIFEST_TYPE parity with ../../ultra, where
# they are needed to fit the 550B model. One node per role already holds Super-VL 120B-A12B
# (BF16 ~249 GB - see ../agg/.env), so they are OPTIONAL here, not required. Each is ultra's
# template with only the Super delta applied. lws-ep, dgd-grove and dgd-grove-ep were served and
# measured live on H200 on 2026-10-19 (see ../test/RESULTS.md). PP>1 DISAGG (lws-2pp, lws-pp2,
# dgd-grove-pp2) is NOT SUPPORTED on the stock 1.5.0-efa runtime: vLLM 0.28.0's NIXL connector
# refuses PP>1 with hybrid-Mamba KV (measured 2026-10-19, RESULTS.md footnotes 26 and 42; the
# gate is still present upstream through v0.32.0). On ultra the ':1.4.0-patched' image carried a
# 0.26-era patch for this; it does not apply to 0.28.0. ../dynamo-vllm-efa/Dockerfile.ray --build-arg
# NIXL_PP_PATCH=1 carries the 0.28.0 backport of the open upstream fix (vllm-project/vllm#53360); with that
# image on BOTH roles (REGISTRY/IMAGE/TAG overrides) the PP>1 shapes were MEASURED on 2026-10-20 on the Dynamo
# 1.5.1 platform (RESULTS.md footnotes lws-2pp BF16 ¹⁰³ / NVFP4 ¹⁰⁶, lws-pp2 BF16 ¹⁰² / NVFP4 ¹⁰⁴, dgd-grove-pp2 BF16 ¹⁰⁸ / NVFP4 ¹⁰⁹).
# dgd-grove-pp2 additionally needs the platform's Grove + KAI feature gates ON (the grove/deploy.sh flip): with them
# off, the 1.5.1 operator sets the DGD to 'no multinode orchestrator available' and creates no pods (footnote ¹⁰⁷).
#
# EVERY P/D template in this folder splits prefill from decode (all carry --kv-transfer-config
# with NixlConnector) - including lws-ep; epd instead moves ENCODER EMBEDDINGS to the PD worker.
# ../agg/.env offers the SAME NAME `lws-ep` for the AGGREGATED wide-EP shape (one `vllm serve`,
# no split, 2 nodes): the FOLDER decides the mode, MANIFEST_TYPE decides the topology within it.
# So label results from here as EP16 DISAGGREGATED and results from ../agg as EP16 AGGREGATED;
# they are not the same run at different node counts.
export MANIFEST_TYPE=${MANIFEST_TYPE:-deployment}

# EP (MANIFEST_TYPE=lws-ep or dgd-grove-ep) only: per-role data-parallel group size;
# EP degree = EP_DP_SIZE * GPU_PER_WORKER, applied INDEPENDENTLY to prefill and to decode.
# dgd-grove-ep also uses it as each role's multinode.nodeCount (one DP rank per node).
# The model's expert count must be divisible by the EP degree (Nemotron 3.5 Super VL: 512
# routed experts per its config.json, EP16 = 32 per rank, exact; Mixtral's 8 experts: no - it
# cannot run EP16).
# Node cost = 2 * EP_DP_SIZE GPU nodes (prefill group + decode group), so the default is 4 nodes.
export EP_DP_SIZE=${EP_DP_SIZE:-2}

# dgd-grove-pp2 only: nodes per multinode worker group, applied to BOTH roles. Each role's
# engine spans NODE_COUNT_PER_WORKER full nodes as TP GPU_PER_WORKER x PP NODE_COUNT_PER_WORKER
# (PP grows with the node count; TP stays inside the node) - the same knob, same meaning as
# ../agg/.env's. Node cost = 2 * NODE_COUNT_PER_WORKER GPU nodes.
export NODE_COUNT_PER_WORKER=${NODE_COUNT_PER_WORKER:-2}

# ---- Cluster shape ----
# All ${VAR:-default} so a different accelerator is a one-liner and needs no edit here:
#   INSTANCE_TYPE_WORKER=p6-b200.48xlarge EFA_PER_WORKER=<node allocatable> ./run.sh
# On SageMaker HyperPod EKS the node label carries an ml. prefix (e.g.
# ml.p6-b200.48xlarge) and B200 nodes advertise 8 EFA, not 16 - read the node, not this file.
export INSTANCE_TYPE_FRONTEND=${INSTANCE_TYPE_FRONTEND:-m5.8xlarge}
export INSTANCE_TYPE_WORKER=${INSTANCE_TYPE_WORKER:-p5en.48xlarge}
export GPU_PER_WORKER=${GPU_PER_WORKER:-8}
# EFA_PER_WORKER must match what the EFA device plugin advertises on YOUR instance type - read
# it, do not assume it, or the GPU pods sit Pending on Insufficient vpc.amazonaws.com/efa:
#   kubectl get node <node> -o jsonpath='{.status.allocatable.vpc\.amazonaws\.com/efa}{"\n"}'
export EFA_PER_WORKER=${EFA_PER_WORKER:-16}
# Per-GPU-pod CPU/memory budget, requests == limits (Guaranteed QoS). 48 fits both
# p5en.48xlarge and p6-b200.48xlarge and leaves headroom for the EFA/GPU DaemonSets.
export CPU_PER_WORKER=${CPU_PER_WORKER:-48}
export MEM_PER_WORKER=${MEM_PER_WORKER:-800Gi}

# epd only: the encode worker's budget. The vision tower (RADIO ViT-H, hidden 1280,
# 32 layers) is small next to the LLM — but see the epd template header for why the
# dynamo v1.5.0 encode path may need far more than the tower alone.
export GPU_PER_ENCODE=${GPU_PER_ENCODE:-1}
export CPU_PER_ENCODE=${CPU_PER_ENCODE:-8}
export MEM_PER_ENCODE=${MEM_PER_ENCODE:-128Gi}

# ---- Model precision toggle (same derivation as ../agg/.env) ----
# MODEL_PATH defaults to where ../download lands the Hugging Face checkpoint (ultra's layout).
# Weights obtained by any other route (for example Early-Access checkpoints already on an FSx
# volume) are served by exporting MODEL_PATH=<their directory> before ./run.sh.
export MODEL_VARIANT="${MODEL_VARIANT:-BF16}"
export MODEL_REPO="${MODEL_REPO:-nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B}"
case "${MODEL_VARIANT}" in
  nvfp4|NVFP4|fp4) _PREC_SUFFIX="NVFP4" ;;
  bf16|BF16|*)     _PREC_SUFFIX="BF16"  ;;
esac
export MODEL_NAME="${MODEL_NAME:-${MODEL_REPO}-${_PREC_SUFFIX}}"
export MODEL_PATH="${MODEL_PATH:-/shared/models/hf/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-${_PREC_SUFFIX}}"

# ---- Engine shape knobs (see ../agg/.env for the reasoning) ----
export MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}
export GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}

# ---- Architecture-name override (REQUIRED on vLLM 0.28.x) ----
# Full explanation in ../agg/.env: vLLM 0.28.0 registers the Super_/Nano_ aliases of this
# architecture but not the checkpoint's bare "NemotronH_Omni_Reasoning_V3" name (that alias
# lands in v0.29.0). The templates pass --hf-overrides with this value.
export HF_OVERRIDE_ARCH=${HF_OVERRIDE_ARCH:-NemotronH_Super_Omni_Reasoning_V3}

# Hybrid-Mamba flags are MODEL-CONDITIONAL, not universal: on a pure-transformer model
# `--mamba-cache-mode align` fails at first inference. Auto-derived from MODEL_NAME;
# override MAMBA_FLAGS='' to force stock behavior.
case "${MODEL_NAME}" in
  *Nemotron*|*nemotron*) _MAMBA_DEFAULT="--mamba-cache-mode align --no-disable-hybrid-kv-cache-manager" ;;
  *)                     _MAMBA_DEFAULT="" ;;
esac
export MAMBA_FLAGS="${MAMBA_FLAGS-${_MAMBA_DEFAULT}}"

# ---- MTP speculative decoding toggle (OFF by default — see ../agg/.env for the full
# rationale and the UNVERIFIED caveat; identical semantics here) ----
export SPEC_DECODE=${SPEC_DECODE:-0}
case "${SPEC_DECODE}" in
  1|true|on) _SPEC_DEFAULT="--speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":1}'" ;;
  *)         _SPEC_DEFAULT="" ;;
esac
export SPEC_DECODE_FLAG="${SPEC_DECODE_FLAG-${_SPEC_DEFAULT}}"

# Weight loader (runai-model-streamer 0.16.1 present in 1.5.0-efa, verified 2026-10-06).
export LOAD_FORMAT="${LOAD_FORMAT:-runai_streamer}"

# NOTE: ../../ultra's --moe-backend flashinfer_cutlass BF16 pin encodes a MEASURED vLLM 0.26
# regression on Nemotron-3-Ultra-550B (vllm#53472); unmeasured on vLLM 0.28/this model, so
# deliberately NOT carried here (vLLM auto selection stays in force).

# ---- Cold-start warmup (same mechanism and knobs as ../agg/.env) ----
export WARMUP_ENABLED=${WARMUP_ENABLED:-auto}
export WARMUP_CONCURRENCY=${WARMUP_CONCURRENCY:-10}

# ---- KV lease duration (seconds the PREFILL side holds KV blocks for DECODE to pull) ----
# Feeds "kv_lease_duration" inside --kv-transfer-config's kv_connector_extra_config in the
# P/D templates. vLLM's NixlConnector default is 30 s; the producer extends a lease by 2/3
# of it per heartbeat and the decode side heartbeats every 1/6 of it, so BOTH roles must get
# the same value (every P/D template here passes it to prefill AND decode). Keys verified at
# vLLM v0.28.0: nixl/base_worker.py lines 277-283 ("backends" default ["UCX"],
# "kv_lease_duration" default 30) and nixl/base_scheduler.py lines 75-81.
# 300 covers the lease-expiry class ../../ultra documented (see ultra/disagg/.env for the
# measured history that picked this number).
export KV_LEASE_DURATION=${KV_LEASE_DURATION:-300}

# ---- Test-only runtime bootstrap for the Ray / PP>1 shapes (default OFF) ----
# lws-2pp (prefill PP2) and lws-pp2 (both roles PP2), bootstrapped by Ray, and dgd-grove-pp2 (both roles PP NODE_COUNT_PER_WORKER via the operator's mp bootstrap)
# need what the stock 1.5.0-efa image lacks: the `ray` package (Ray-bootstrapped shapes) and the
# SupportsPP patch for the NemotronH_Nano_VL_V2 wrapper (every PP>1 shape: vLLM 0.28.0 refuses PP>1 for
# it at verify_with_parallel_config). ../dynamo-vllm-efa/Dockerfile.ray bakes both into the golden image -
# that is the production path. RUNTIME_BOOTSTRAP=1 is the test-only fallback for a cluster that cannot
# pull a golden image yet: run.sh publishes ../dynamo-vllm-efa/patches/ as a ConfigMap, the affected
# vllm containers run as root (the image's vllm tree is root-owned) and apply it at start
# (pip install ray[default]==2.55.1 + apply_pp_patch.py; +2-4 min per pod start). Default OFF renders
# the stock-image manifests: the bootstrap line is a no-op ':' and the ConfigMap volume is optional.
export RUNTIME_BOOTSTRAP=${RUNTIME_BOOTSTRAP:-0}
case "${RUNTIME_BOOTSTRAP}" in
  1|true|on)
    _RB_RAY='bash /opt/runtime-bootstrap/runtime-bootstrap.sh ray'
    _RB_PATCH='bash /opt/runtime-bootstrap/runtime-bootstrap.sh patch'
    _RB_SC=', runAsUser: 0' ;;
  *) _RB_RAY=':'; _RB_PATCH=':'; _RB_SC='' ;;
esac
export RUNTIME_BOOTSTRAP_RAY_CMD="${_RB_RAY}"
export RUNTIME_BOOTSTRAP_PATCH_CMD="${_RB_PATCH}"
export RUNTIME_BOOTSTRAP_SECURITY_CONTEXT="${_RB_SC}"

# ETCD and NATS endpoints
export ETCD_URL=http://dynamo-platform-etcd.dynamo-system.svc.cluster.local:2379
export NATS_URL=nats://dynamo-platform-nats.dynamo-system.svc.cluster.local:4222
