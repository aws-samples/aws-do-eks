                if ! ( : > "${DOLLAR}LOG_DIR/.wtest-${DOLLAR}HOSTNAME" ) 2>/dev/null; then
                  echo "[decode p5en] ${DOLLAR}LOG_DIR not writable; logging to /tmp instead"
