#!/bin/bash

export DOLLAR='$'
# DEPLOYMENT_TYPE=agg|disagg
export DEPLOYMENT_TYPE="${DEPLOYMENT_TYPE:-agg}"
# ${DEPLOYMENT_NAME:-default}: ../agg/.env and ../disagg/.env let a caller deploy under another name
# (two topologies of one folder side by side); the benchmark has to follow that override or it
# measures the wrong stack. Measured 2026-10-21: with the unconditional export this file carried
# before, a stack deployed as DEPLOYMENT_NAME=<x> was probed and benchmarked at
# nemotron3-ultra-550b-agg-frontend, a Service that did not exist. Default = the folders' default name.
export DEPLOYMENT_NAME=${DEPLOYMENT_NAME:-nemotron3-ultra-550b-${DEPLOYMENT_TYPE}}

# MANIFEST_TYPE mirrors ../${DEPLOYMENT_TYPE}/.env and is used here for one purpose only:
# scoping the aiperf artifact directory. Nothing in test/ renders a manifest, so a value that
# does not match the deployed topology only mislabels the results folder.
# agg: deployment|lws|lws-ep|dgd-v1alpha1|dgd-v1beta1
# disagg: deployment|lws-2pp|lws-pp2|lws-ep|dgd-v1alpha1|dgd-v1beta1
export MANIFEST_TYPE="${MANIFEST_TYPE:-dgd-v1alpha1}"
export SERVICE_NAME=${DEPLOYMENT_NAME}-frontend
# ${NAMESPACE:-default}, matching ../agg/.env and ../disagg/.env: an unconditional export
# here silently clobbers a caller's namespace override, so a stack deployed with
# NAMESPACE=<ns> gets benchmarked by a do-aiperf pod created in `default` — where fsx-pvc
# does not exist, so the pod sits Pending with no host and every artifact collection fails.
export NAMESPACE=${NAMESPACE:-default}
export SERVICE_URL="http://${SERVICE_NAME}.${NAMESPACE}.svc.cluster.local:8000"

export MODEL_VARIANT="${MODEL_VARIANT:-BF16}"
case "${MODEL_VARIANT}" in
  nvfp4|NVFP4|fp4) _PREC_SUFFIX="NVFP4" ;;
  bf16|BF16|*)     _PREC_SUFFIX="BF16"  ;;
esac

export MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-${_PREC_SUFFIX}
export MODEL_PATH=/shared/models/hf/nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-${_PREC_SUFFIX}


# Pod name of the aiperf client (as in ../../super/test/.env). Override to run two benchmarks in one
# namespace at once - e.g. two topologies of one folder deployed side by side under different
# DEPLOYMENT_NAMEs; with one fixed name the second test-aiperf.sh collides with the first's pod.
export AIPERF_POD_NAME="${AIPERF_POD_NAME:-do-aiperf}"
