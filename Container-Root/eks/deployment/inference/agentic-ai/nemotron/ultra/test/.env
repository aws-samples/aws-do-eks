#!/bin/bash

export DOLLAR='$'
# DEPLOYMENT_TYPE=agg|disagg
export DEPLOYMENT_TYPE=agg
export DEPLOYMENT_NAME=nemotron3-ultra-550b-${DEPLOYMENT_TYPE}
export SERVICE_NAME=${DEPLOYMENT_NAME}-frontend
export NAMESPACE=default
export SERVICE_URL="http://${SERVICE_NAME}.${NAMESPACE}.svc.cluster.local:8000"

#export MODEL_VARIANT=NVFP4
export MODEL_VARIANT="${MODEL_VARIANT:-BF16}"
case "${MODEL_VARIANT}" in
  nvfp4|NVFP4|fp4) _PREC_SUFFIX="NVFP4" ;;
  bf16|BF16|*)     _PREC_SUFFIX="BF16"  ;;
esac

export MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-${_PREC_SUFFIX}
export MODEL_PATH=/shared/models/hf/nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-${_PREC_SUFFIX}

