                  --served-model-name ${MODEL_NAME} \
                  --headless \
                  --data-parallel-start-rank ${DOLLAR}{LWS_WORKER_INDEX} \
                  --tensor-parallel-size ${GPU_PER_WORKER} \
                  --data-parallel-size ${EP_DP_SIZE} \
