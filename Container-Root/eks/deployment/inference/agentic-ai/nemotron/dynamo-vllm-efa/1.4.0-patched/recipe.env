# recipe.env - what the shared ../buildspec.yaml builds when RECIPE=1.4.0-patched (sourced by ../select-recipe.sh; the
# buildspec's own values are the 1.5.0 recipe's, these replace them). REGISTRY, GATE_SEVERITY and MAX_HIGH stay the buildspec's.
#
# Author: Anton Alexander
BASE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.4.0-efa"
IMAGE="dynamo-vllm-efa:1.4.0-patched"
# This Dockerfile has no opt-in patch ARGs (the 0.26 PP>1 NIXL layer is always on): no build args.
DOCKER_BUILD_ARGS=""
