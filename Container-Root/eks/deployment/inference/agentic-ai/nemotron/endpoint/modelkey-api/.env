#!/bin/bash

# The private REST API that hands the model key to IAM-authenticated callers inside a VPC - one CloudFormation stack
# (template.yaml): Secrets Manager secret (the key, generated in the account - it never exists in a file), Lambda +
# role, PRIVATE RestApi with POST /modelkey (AWS_IAM) and its resource policy, deployment + stage.
# Deploy with ./deploy.sh, remove with ./remove.sh, rotate the key with ./rotate.sh (then ../gateway/secret-sync.sh).
# Every knob is ${VAR:-default}: a launch-line override wins.

# Region of the API = the region of the callers' execute-api interface endpoints (Workshop Studio events run in
# us-west-2 / us-east-1; the serving cluster can be anywhere - the key is just a string).
export API_REGION=${API_REGION:-us-west-2}
export STACK_NAME=${STACK_NAME:-nemotron-modelkey-api}
export STAGE_NAME=${STAGE_NAME:-dev}
# The secret the stack creates; ../gateway/.env reads the same name (SECRET_NAME) and region (SECRET_REGION).
export SECRET_NAME=${SECRET_NAME:-nemotron/modelkey}

# What the API returns beside the key: the public base URL of the key gateway and the served model name
# (MODEL_NAME of the serving folder's .env). Keep ENDPOINT_HOST equal to ../gateway/.env.
export ENDPOINT_HOST=${ENDPOINT_HOST:-nemotron.example.com}
export ENDPOINT_URL=${ENDPOINT_URL:-https://${ENDPOINT_HOST}/v1}
export MODEL_ID=${MODEL_ID:-nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-BF16}

# Who may invoke. Empty = any AWS principal that holds execute-api:Invoke on the method AND reaches the API through an
# execute-api interface endpoint (the API is PRIVATE, so there is no path from the internet). Set PRINCIPAL_ORG_ID to
# the Workshop Studio organization id (o-xxxxxxxxxx) to pin callers to its accounts, and/or SOURCE_VPCE_IDS to a
# comma-separated list of allowed endpoint ids.
export PRINCIPAL_ORG_ID=${PRINCIPAL_ORG_ID:-}
export SOURCE_VPCE_IDS=${SOURCE_VPCE_IDS:-}
