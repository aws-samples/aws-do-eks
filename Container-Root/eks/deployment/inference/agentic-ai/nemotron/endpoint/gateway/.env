#!/bin/bash

# Key gateway in front of a Nemotron frontend: a small nginx Deployment that forwards only requests carrying
# `Authorization: Bearer <MODEL_KEY>` to the frontend Service and answers 403 to everything else, published on the
# cluster's existing ingress-nginx controller as a TLS Ingress (certificate from cert-manager). The Dynamo frontend
# itself has no request-authentication option (python3 -m dynamo.frontend --help on dynamo 1.5.0 lists TLS flags
# only), so the check sits in front of it and the frontend never sees the key (the gateway strips the header).
#
# Every knob is ${VAR:-default} so a launch-line override wins and nothing here clobbers the caller's environment
# (same rule as ../../super/agg/.env: an unconditional NAMESPACE export would let stop.sh delete in somebody else's
# namespace).

export DOLLAR='$'

# ---- Where the frontend is ----
# NAMESPACE = the namespace of the serving deployment; the gateway lands there too (same-namespace Service DNS).
export NAMESPACE=${NAMESPACE:-default}
# DEPLOYMENT_NAME of the serving stack (../../super/agg/.env, ../../super/disagg/.env, ../../ultra/*/.env); the
# frontend Service every template in those folders creates is ${DEPLOYMENT_NAME}-frontend on port 8000.
export DEPLOYMENT_NAME=${DEPLOYMENT_NAME:-nemotron35-super-vl-120b-agg}
export TARGET_SERVICE=${TARGET_SERVICE:-${DEPLOYMENT_NAME}-frontend}
export TARGET_PORT=${TARGET_PORT:-8000}

# ---- The gateway ----
export GATEWAY_NAME=${GATEWAY_NAME:-nemotron-keygate}
# Official unprivileged nginx image (runs as uid 101, listens on 8080, supports /etc/nginx/templates envsubst with
# NGINX_ENVSUBST_FILTER). Pin a digest for a frozen deployment: GATEWAY_IMAGE=public.ecr.aws/nginx/nginx-unprivileged:1.28-alpine@sha256:<digest>
export GATEWAY_IMAGE=${GATEWAY_IMAGE:-public.ecr.aws/nginx/nginx-unprivileged:1.28-alpine}
export GATEWAY_REPLICAS=${GATEWAY_REPLICAS:-2}
# The Kubernetes Secret that holds the key (data key MODEL_KEY). Created by ./secret-sync.sh from the Secrets Manager
# secret of ../modelkey-api - never by a manifest, never from a file. Rotation = ../modelkey-api/rotate.sh + ./secret-sync.sh.
export GATEWAY_SECRET_NAME=${GATEWAY_SECRET_NAME:-${GATEWAY_NAME}}
# Per-source-IP rate limit on the gateway (requests/second, burst = 2x). Protects the 403 path from scanners once the
# hostname shows up in certificate-transparency logs; attendees behind one NAT share a source IP - raise it if a venue
# network throttles.
export RATE_LIMIT_RPS=${RATE_LIMIT_RPS:-20}
# Upstream timeouts (seconds). A 512-token non-streamed answer takes ~45 s on one H200 node; streaming sends a chunk
# every ~90 ms so neither this nor the load balancer idle timeout is approached. 600 leaves room for long answers.
export PROXY_TIMEOUT=${PROXY_TIMEOUT:-600}
# Request body limit: a vision-language request carries base64 images in messages.
export MAX_BODY_SIZE=${MAX_BODY_SIZE:-20m}

# ---- Secrets Manager source of the key (the same values as ../modelkey-api/.env) ----
export SECRET_REGION=${SECRET_REGION:-us-west-2}
export SECRET_NAME=${SECRET_NAME:-nemotron/modelkey}

# ---- The public name ----
# The hostname attendees use; the CNAME to the ingress controller's load balancer must exist BEFORE run.sh (the
# HTTP-01 challenge is answered through that name). ./dns-cname.sh creates it when HOSTED_ZONE_ID is set.
export ENDPOINT_HOST=${ENDPOINT_HOST:-nemotron.example.com}
export HOSTED_ZONE_ID=${HOSTED_ZONE_ID:-}
export INGRESS_CLASS=${INGRESS_CLASS:-nginx}
export INGRESS_CONTROLLER_NAMESPACE=${INGRESS_CONTROLLER_NAMESPACE:-ingress-nginx}
export INGRESS_CONTROLLER_SERVICE=${INGRESS_CONTROLLER_SERVICE:-ingress-nginx-controller}
# cert-manager ClusterIssuer (ACME HTTP-01 through the same Ingress). The TLS Secret is ${GATEWAY_NAME}-tls.
export CLUSTER_ISSUER=${CLUSTER_ISSUER:-letsencrypt-prod}
